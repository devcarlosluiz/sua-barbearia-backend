# ==========================================================
# SUA BARBEARIA - BACKEND - Producao (modelo)
#
# Na VM:  cp .env.prod.example .env   e preencha o que esta marcado com TROQUE.
# O compose de producao le o mesmo arquivo .env do de desenvolvimento.
# NUNCA comite o .env preenchido.
# ==========================================================

# --- Dominio ---
# Fonte unica para o nginx (server_name e caminho do certificado) e para o
# scripts/init_letsencrypt.sh. Para trocar de dominio, mude AQUI e nas tres
# variaveis do Django abaixo -- o docker/nginx/prod.conf.template nao precisa
# ser editado.
DOMAIN=clmlabs.com.br

# --- Django ---
DEBUG=False
DJANGO_SETTINGS_MODULE=config.settings.prod

# TROQUE. Gere assim, na VM:
#   docker compose run --rm backend python -c "from django.core.management.utils import get_random_secret_key as g; k=g(); print(k if not k.startswith('$') else g())"
#
# O valor NAO pode comecar com "$": o django-environ trataria como referencia a
# outra variavel, nao acharia, e cairia silenciosamente no default inseguro do
# codigo -- assinando todo JWT com uma string publica, sem erro nem aviso.
# O comando acima ja regera a chave nesse caso.
SECRET_KEY=TROQUE

# `localhost` e `127.0.0.1` sao necessarios: o healthcheck do container backend
# chama http://localhost:8000/health/ e um host fora desta lista vira 400
# DisallowedHost -- o healthcheck falharia e o celery/beat nunca subiriam.
ALLOWED_HOSTS=clmlabs.com.br,localhost,127.0.0.1

# Precisa do esquema. Sem isso o login do admin do Django falha com CSRF.
CSRF_TRUSTED_ORIGINS=https://clmlabs.com.br

# --- HTTPS ---
# O nginx termina o TLS e repassa X-Forwarded-Proto; o prod.py ja confia nesse
# header via SECURE_PROXY_SSL_HEADER.
SECURE_SSL_REDIRECT=True

# Comece em 0 enquanto valida o dominio. O HSTS faz o navegador GUARDAR por um
# ano a regra "so acesso este host por HTTPS" -- se o certificado quebrar antes
# disso, nao ha como acessar em HTTP nem limpando o cache comum.
# Depois que estiver estavel, suba para 31536000.
SECURE_HSTS_SECONDS=0

# --- Database (PostgreSQL) ---
# TROQUE a senha. O postgres nao fica exposto ao host em producao
# (docker-compose.prod.yml zera o mapeamento de porta), mas a senha vale.
DATABASE_NAME=suabarbearia
DATABASE_USER=suabarbearia
DATABASE_PASSWORD=TROQUE
DATABASE_HOST=postgres
DATABASE_PORT=5432

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Dimensionamento (ajuste ao tamanho da VM) ---
GUNICORN_WORKERS=4
CELERY_CONCURRENCY=4

# --- CORS ---
# Origens do app Flutter Web. Enquanto o app nao estiver publicado, o proprio
# dominio basta para o Swagger funcionar.
CORS_ALLOWED_ORIGINS=https://clmlabs.com.br

# --- JWT (minutos / dias) ---
JWT_ACCESS_LIFETIME=60
JWT_REFRESH_LIFETIME=7

# --- Entrar com o Google ---
# Client IDs de PRODUCAO, separados por virgula (Android, iOS e Web). O Android
# exige o SHA-1 da chave de assinatura de release cadastrado na credencial --
# com o SHA-1 de debug, o token do app publicado nao e emitido.
# Vazio desliga /auth/google/ (503); o login por e-mail e senha segue normal.
GOOGLE_OAUTH_CLIENT_IDS=

# --- Email ---
# O backend de console apenas imprime no log do container: serve para validar o
# fluxo de reset de senha sem configurar SMTP. Troque quando quiser envio real.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=nao-responda@clmlabs.com.br
FRONTEND_RESET_PASSWORD_URL=https://clmlabs.com.br/reset-password

#EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#EMAIL_HOST=smtp.gmail.com
#EMAIL_PORT=587
#EMAIL_USE_TLS=True
#EMAIL_HOST_USER=voce@gmail.com
#EMAIL_HOST_PASSWORD=
#EMAIL_TIMEOUT=10

# --- Push notifications ---
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_JSON=

# --- Asaas ---
# Use a chave do ambiente sandbox neste ambiente.
# ATENCAO: a chave comeca com "$" — escreva-a com o "$" DOBRADO
# ("$$aact_..."), senao o docker-compose troca por uma string vazia ao
# carregar este arquivo via `env_file`. Veja o comentário em .env.example.
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
# Token estático configurado ao cadastrar o webhook no painel do Asaas,
# apontando para https://clmlabs.com.br/api/v1/webhooks/asaas/
ASAAS_WEBHOOK_TOKEN=

# --- Assinaturas ---
SUBSCRIPTION_PIX_EXPIRATION_MINUTES=60
SUBSCRIPTION_PIX_RENEWAL_LEAD_DAYS=5
SUBSCRIPTION_GRACE_PERIOD_DAYS=3

# --- Observabilidade ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging

# --- Seed ---
# Este ambiente e de teste, entao o seed_data faz sentido. TROQUE a senha:
# ela vale para os tres usuarios de demonstracao num host publico.
SEED_DEFAULT_PASSWORD=TROQUE
