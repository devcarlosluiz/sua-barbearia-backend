# ==========================================================
# SUA BARBEARIA - BACKEND - Environment variables (example)
# Copy to .env and adjust. NEVER commit the real .env file.
#
# O app Flutter tem o seu proprio .env.example, no repositorio
# sua-barbearia-frontend. Aqui ficam apenas as variaveis do Django.
# ==========================================================

# --- Django ---
DEBUG=True

# ATENCAO: o valor NAO pode comecar com "$".
#
# O django-environ trata um valor que comeca com "$" como REFERENCIA a outra
# variavel de ambiente. Nao encontrando essa variavel, ele devolve o default do
# codigo -- ou seja, o Django roda silenciosamente com
# "insecure-dev-key-change-me", e o JWT_SIGNING_KEY (que herda do SECRET_KEY)
# passa a assinar todos os tokens com uma string publica. Nao ha erro nem aviso.
#
# As aspas nao protegem: elas sao removidas antes da checagem do "$".
# O charset do get_random_secret_key() do Django inclui "$", entao isso acontece
# por acaso com alguma frequencia.
#
# Gere uma chave e confira que o primeiro caractere nao e "$":
#   python -c "from django.core.management.utils import get_random_secret_key as g; k=g(); print(k if not k.startswith('$') else g())"
SECRET_KEY=change-me-in-production-use-a-50-char-random-string
DJANGO_SETTINGS_MODULE=config.settings.dev
ALLOWED_HOSTS=localhost,127.0.0.1,backend
# 8000 = runserver; 8081 = Nginx do perfil `full` deste stack.
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://localhost:8081

# --- Database (PostgreSQL) ---
DATABASE_NAME=suabarbearia
DATABASE_USER=suabarbearia
DATABASE_PASSWORD=suabarbearia
DATABASE_HOST=postgres
DATABASE_PORT=5432

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- CORS ---
# Origens do Flutter Web (stack sua-barbearia-frontend, porta 8080). Os dois stacks
# Docker sao independentes: o app chama a API do navegador, nao de dentro da
# rede do Docker, por isso o que libera o acesso e o CORS -- nao uma rede
# compartilhada.
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000,http://127.0.0.1:8080,http://10.0.2.2:8080

# --- JWT (values in minutes / days) ---
JWT_ACCESS_LIFETIME=60
JWT_REFRESH_LIFETIME=7

# --- Entrar com o Google ---
# Client IDs criados em https://console.cloud.google.com/apis/credentials
# (tela de consentimento OAuth + credenciais do tipo "ID do cliente OAuth").
#
# Liste TODOS separados por virgula: Android, iOS e Web tem IDs diferentes, e o
# backend so aceita o token se o `aud` dele estiver aqui. Nao e segredo -- o
# client ID vai embutido no proprio app. Vazio desliga /auth/google/ (503).
GOOGLE_OAUTH_CLIENT_IDS=317454084981-mnamuml8rolp6pja376vvj4dkdsqnqfk.apps.googleusercontent.com

# --- Email (dev uses console backend) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=nao-responda@suabarbearia.com.br
FRONTEND_RESET_PASSWORD_URL=http://localhost:8080/reset-password

# Para enviar de verdade pelo Gmail, troque o backend acima por
# django.core.mail.backends.smtp.EmailBackend e preencha o bloco abaixo.
#
# EMAIL_HOST_PASSWORD é uma "Senha de app" de 16 caracteres gerada em
# https://myaccount.google.com/apppasswords (exige verificacao em duas etapas).
# A senha normal da conta e recusada pelo Gmail desde 2022.
#
# O Gmail reescreve o remetente para a conta autenticada: DEFAULT_FROM_EMAIL
# precisa ser o mesmo endereco de EMAIL_HOST_USER, ou um alias verificado.
#EMAIL_HOST=smtp.gmail.com
#EMAIL_PORT=587
#EMAIL_USE_TLS=True
#EMAIL_HOST_USER=voce@gmail.com
#EMAIL_HOST_PASSWORD=
#EMAIL_TIMEOUT=10

# --- Push notifications (future integration) ---
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_JSON=

# --- Mercado Pago (planos mensais) ---
# Credenciais em https://www.mercadopago.com.br/developers/panel/app
# Use as de TESTE (prefixo TEST-) enquanto valida o fluxo.
# NUNCA comite os valores reais: este arquivo é só o modelo.
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
# Segredo da assinatura dos webhooks ("Assinatura secreta" no painel).
# Sem ele o endpoint de webhook recusa todas as chamadas.
MERCADO_PAGO_WEBHOOK_SECRET=
# URL pública que o Mercado Pago chama ao mudar o status de um pagamento.
# Em desenvolvimento use um túnel (ex.: ngrok) apontando para o backend.
MERCADO_PAGO_NOTIFICATION_URL=
# Para onde o cliente volta após informar o cartão no checkout do provedor.
MERCADO_PAGO_BACK_URL=http://localhost:8080/client/plans

# --- Assinaturas ---
SUBSCRIPTION_PIX_EXPIRATION_MINUTES=60
SUBSCRIPTION_PIX_RENEWAL_LEAD_DAYS=5
SUBSCRIPTION_GRACE_PERIOD_DAYS=3
# Após emitir o QR, de quanto em quanto tempo (e quantas vezes) perguntar ao
# Mercado Pago se o PIX foi pago. O padrão cobre os 10 primeiros minutos, que é
# quando o cliente está com o app aberto esperando. Zero desliga e deixa a
# ativação por conta do webhook + varredura de 20 em 20 minutos.
SUBSCRIPTION_PIX_POLL_INTERVAL_SECONDS=15
SUBSCRIPTION_PIX_POLL_ATTEMPTS=40

# --- Observability (future integration) ---
SENTRY_DSN=

# --- Seed data (development only) ---
SEED_DEFAULT_PASSWORD=SuaBarbearia@2026
