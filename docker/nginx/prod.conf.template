# Proxy reverso de produção: TLS do Let's Encrypt + static/media.
#
# MODELO, não configuração final. O container do nginx roda `envsubst` neste
# arquivo na subida, substituindo apenas ${DOMAIN} — as variáveis do próprio
# nginx ($host, $scheme, $request_uri...) passam intactas porque o envsubst é
# chamado com a lista explícita de nomes a substituir.
#
# Para trocar de domínio, mexa só no DOMAIN do .env. Não edite este arquivo.
#
# O `nginx.conf` ao lado continua sendo o de desenvolvimento (HTTP na 8081).

upstream suabarbearia_backend {
    server backend:8000;
}

# Host desconhecido (varredura pelo IP, domínio apontado por engano) morre
# aqui, em vez de virar um 400 DisallowedHost no Django.
server {
    listen 80 default_server;
    listen 443 ssl default_server;
    server_name _;
    ssl_reject_handshake on;
    return 444;
}

# HTTP existe só para o desafio do ACME e para empurrar todo o resto ao HTTPS.
server {
    listen 80;
    server_name ${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    # Upload de logo e imagens de produto.
    client_max_body_size 20M;

    # HSTS não entra aqui: o Django já emite o header via SECURE_HSTS_SECONDS.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location /static/ {
        alias /var/www/static/;
        expires 30d;
        access_log off;
    }

    location /media/ {
        alias /var/www/media/;
        expires 7d;
        access_log off;
    }

    location / {
        proxy_pass http://suabarbearia_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # É este header que faz o SECURE_SSL_REDIRECT do Django enxergar HTTPS.
        # Sem ele o Django redireciona para https em looping.
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
        proxy_redirect off;
    }
}
