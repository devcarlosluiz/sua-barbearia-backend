# Proxy reverso de produção: TLS do Let's Encrypt, Django e app Flutter.
#
# MODELO, não configuração final. O container do nginx roda `envsubst` neste
# arquivo na subida, substituindo apenas ${DOMAIN} — as variáveis do próprio
# nginx ($host, $scheme, $request_uri...) passam intactas porque o envsubst é
# chamado com a lista explícita de nomes a substituir.
#
# Para trocar de domínio, mexa só no DOMAIN do .env. Não edite este arquivo.
#
# Repartição das rotas, tudo sob o mesmo domínio e o mesmo certificado:
#
#   /api/ /admin/ /health/ /static/ /media/  -> Django
#   qualquer outra coisa                     -> app Flutter (container `frontend`)
#
# Mesma origem para o app e a API significa que o navegador não faz requisição
# cross-origin: o CORS deixa de participar da conversa.
#
# O `nginx.conf` ao lado continua sendo o de desenvolvimento (HTTP na 8081).

upstream suabarbearia_backend {
    server backend:8000;
}

# Host desconhecido (varredura pelo IP, domínio apontado por engano) morre
# aqui, em vez de virar um 400 DisallowedHost no Django.
server {
    listen 80 default_server;
    listen 443 ssl default_server;
    server_name _;
    ssl_reject_handshake on;
    return 444;
}

# HTTP existe só para o desafio do ACME e para empurrar todo o resto ao HTTPS.
server {
    listen 80;
    server_name ${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    # Upload de logo e imagens de produto.
    client_max_body_size 20M;

    # HSTS não entra aqui: o Django já emite o header via SECURE_HSTS_SECONDS.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Definidos uma vez no server e herdados por todos os `location` abaixo.
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    # É este header que faz o SECURE_SSL_REDIRECT do Django enxergar HTTPS.
    # Sem ele o Django redireciona para https em looping.
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Request-ID $request_id;
    proxy_redirect off;

    # ------------------------------------------------------------------
    # Django
    # ------------------------------------------------------------------
    location /api/    { proxy_pass http://suabarbearia_backend; }
    location /admin/  { proxy_pass http://suabarbearia_backend; }
    location /health/ { proxy_pass http://suabarbearia_backend; }

    # `static` e `media` são do Django e não colidem com o app: o build do
    # Flutter publica em /assets/, /canvaskit/, /icons/ e /v/<hash>/.
    location /static/ {
        alias /var/www/static/;
        expires 30d;
        access_log off;
    }

    location /media/ {
        alias /var/www/media/;
        expires 7d;
        access_log off;
    }

    # ------------------------------------------------------------------
    # App Flutter
    # ------------------------------------------------------------------
    location / {
        # Resolução em tempo de REQUISIÇÃO, não de inicialização.
        #
        # Um `upstream { server frontend:80; }` faria o nginx resolver o nome
        # ao carregar a configuração e ABORTAR com "host not found in upstream"
        # enquanto o container do app não existisse — derrubando junto a API, o
        # admin e o desafio do ACME. Com o endereço numa variável e o resolver
        # interno do Docker (127.0.0.11), o nginx sobe normalmente e só falha a
        # rota do app.
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $app_upstream http://frontend:80;
        proxy_pass $app_upstream$request_uri;

        # Enquanto o app não estiver publicado, a raiz cai na documentação da
        # API em vez de devolver um 502 seco.
        proxy_next_upstream off;
        error_page 502 503 504 = @app_indisponivel;
    }

    location @app_indisponivel {
        return 302 /api/docs/;
    }
}
